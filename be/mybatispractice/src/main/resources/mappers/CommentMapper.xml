<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mybatispractice.features.comments.repository.CommentMapper">

    <!-- findByPostId --> 
    <select id="findByPostId" parameterType = "java.lang.Integer" resultType = "com.example.mybatispractice.features.comments.domain.DTO.CommentResponseDTO">
        SELECT COMMENT, POSTID, EMAIL, ID
        FROM SPRING_COMMENT_TBL
        WHERE POSTID = #{postId}
        ORDER BY ID ASC
    </select>

    <!-- write --> 
    <insert id="write" parameterType="com.example.mybatispractice.features.comments.domain.DTO.CommentRequestDTO">
        <selectKey keyProperty="id" resultType="int" order="BEFORE">
            SELECT NEXTVAL(COMMENTID)
        </selectKey>
        INSERT INTO SPRING_COMMENT_TBL(ID, COMMENT, POSTID, EMAIL)
        VALUES(#{id}, #{comment}, #{postId}, #{email})
    </insert>

    <!-- delete -->
    <delete id="delete" parameterType="java.lang.Integer">
        DELETE FROM SPRING_COMMENT_TBL WHERE ID = ${id}
    </delete>

    <!-- update --> 
    <update id="update" parameterType="java.util.HashMap">
        UPDATE SPRING_COMMENT_TBL
        SET COMMENT = #{comment}
        WHERE ID = #{id}
    </update>
</mapper>